# Claude synthesis (slide titles/bullets/citation mapping)
ANTHROPIC_API_KEY=

# Embeddings for RAG retrieval (Anthropic's recommended embedding provider;
# used instead of a multi-GB local model so setup stays fast). Get a key at
# https://www.voyageai.com/
VOYAGE_API_KEY=

# Optional: an email address to use OpenAlex's faster "polite pool" instead
# of the shared rate limit. No API key needed — OpenAlex is free/open.
# See https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=

# Postgres with the pgvector extension enabled
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_deck

# Redis, used by BullMQ to queue deck-generation jobs. In production this
# must be reachable from BOTH the Vercel API and the Fly worker — a local
# Redis (as below) only works when everything runs on one machine. Upstash
# Redis (upstash.com) is the easiest option that's reachable from anywhere.
REDIS_URL=redis://localhost:6379

# Vercel Blob token, used by the worker to upload the generated .pptx so the
# Vercel API (a different host/filesystem) can serve it. Only needed once the
# worker is deployed somewhere other than your own machine. Created via the
# "Storage" tab in the Vercel dashboard (or `vercel blob store add`), which
# also injects it automatically into the Vercel project's own env vars.
BLOB_READ_WRITE_TOKEN=

# Path to the venv's python if the pipeline deps (worker/pipeline/requirements.txt)
# were installed into a virtualenv rather than the system Python, e.g.:
# PYTHON_BIN=./.venv/Scripts/python.exe  (Windows)
# PYTHON_BIN=./.venv/bin/python          (macOS/Linux)
PYTHON_BIN=python
