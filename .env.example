# Claude synthesis (slide titles/bullets/citation mapping)
ANTHROPIC_API_KEY=

# Embeddings for RAG retrieval (Anthropic's recommended embedding provider;
# used instead of a multi-GB local model so setup stays fast). Get a key at
# https://www.voyageai.com/
VOYAGE_API_KEY=

# Optional: raises Semantic Scholar's unauthenticated rate limit (~1 req/sec
# without it). Request one at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Postgres with the pgvector extension enabled
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_deck

# Redis, used by BullMQ to queue deck-generation jobs
REDIS_URL=redis://localhost:6379

# Path to the venv's python if the pipeline deps (worker/pipeline/requirements.txt)
# were installed into a virtualenv rather than the system Python, e.g.:
# PYTHON_BIN=./.venv/Scripts/python.exe  (Windows)
# PYTHON_BIN=./.venv/bin/python          (macOS/Linux)
PYTHON_BIN=python
